# Copy this file to .env.agent and replace placeholders locally.
# Never commit .env.agent or put real credentials in this file.

GH_TOKEN=<FILL_ME_FINE_GRAINED_GITHUB_TOKEN>

# Reserved for the next Turso migration phase. Keep the application on SQLite for now.
TURSO_DATABASE_URL=libsql://<FILL_ME_DATABASE>.turso.io
TURSO_AUTH_TOKEN=<FILL_ME_DATABASE_SCOPED_TOKEN>

VERCEL_TOKEN=<OPTIONAL_FILL_ME_VERCEL_TOKEN>
BLOB_READ_WRITE_TOKEN=<OPTIONAL_FILL_ME_BLOB_TOKEN>

DATABASE_PROVIDER=sqlite
SQLITE_DATABASE_URL=file:./data/dev.sqlite
CERTIFICATE_ISSUANCE_MODE=fully_online_demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

LOCAL_DEMO_SECRET=<FILL_ME_MINIMUM_32_CHARACTER_RANDOM_SECRET>
LOCAL_DEMO_ADMIN_EMAIL=<FILL_ME_ADMIN_EMAIL>
LOCAL_DEMO_ADMIN_PASSWORD=<FILL_ME_STRONG_DEMO_PASSWORD>

TRUST_PROXY=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<FILL_ME_GMAIL_ADDRESS>
SMTP_PASS=<FILL_ME_GMAIL_APP_PASSWORD>
EMAIL_FROM=Barangay Bato e-Certificate <FILL_ME_GMAIL_ADDRESS>

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
