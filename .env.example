DATABASE_PROVIDER=sqlite
SQLITE_DATABASE_URL=file:./data/dev.sqlite
# Thesis-defense default. Use hybrid_physical_original only for office pickup demos.
CERTIFICATE_ISSUANCE_MODE=fully_online_demo

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy names are still accepted for compatibility, but the names above are preferred.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<FILL_ME_GMAIL_ADDRESS>
SMTP_PASS=<FILL_ME_GMAIL_APP_PASSWORD>
EMAIL_FROM=Barangay Bato e-Certificate <FILL_ME_GMAIL_ADDRESS>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fill these values before using local demo authentication.
LOCAL_DEMO_ADMIN_EMAIL=
LOCAL_DEMO_ADMIN_PASSWORD=
# Required in SQLite mode. Generate locally with: openssl rand -base64 32
LOCAL_DEMO_SECRET=
# Set true only behind a trusted reverse proxy that sets x-forwarded-for.
TRUST_PROXY=false
