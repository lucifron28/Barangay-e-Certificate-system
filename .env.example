DATABASE_PROVIDER=sqlite
SQLITE_DATABASE_URL=file:./data/dev.sqlite
# Production database mode. Use turso only after the remote database and migrations are prepared.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Certificate PDFs stay private. Use local for SQLite development and vercel_blob in production.
CERTIFICATE_STORAGE_PROVIDER=local
CERTIFICATE_STORAGE_DIRECTORY=data/certificates
BLOB_READ_WRITE_TOKEN=

# Required for persistent provider-neutral sessions. Generate a random value of at least 32 characters.
SESSION_COOKIE_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy names are still accepted for compatibility, but the names above are preferred.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<FILL_ME_GMAIL_ADDRESS>
SMTP_PASS=<FILL_ME_GMAIL_APP_PASSWORD>
EMAIL_FROM=Barangay Bato e-Certificate <FILL_ME_GMAIL_ADDRESS>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fill these values before using local demo authentication.
LOCAL_DEMO_ADMIN_EMAIL=
LOCAL_DEMO_ADMIN_PASSWORD=
# Required in SQLite mode when SESSION_COOKIE_SECRET is empty. Generate locally with: openssl rand -base64 32
LOCAL_DEMO_SECRET=

# Required only for the trusted Turso thesis-demo seed command.
DEMO_ADMIN_PASSWORD=
DEMO_RESIDENT_PASSWORD=
# Set true only behind a trusted reverse proxy that sets x-forwarded-for.
TRUST_PROXY=false
